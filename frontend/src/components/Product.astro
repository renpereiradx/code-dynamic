---
import type { Dict } from "../i18n/es";

const { dict } = Astro.props as { dict: Dict };

type ProductItem = Dict["products"]["items"][number];

const PRODUCT_URLS: Record<string, { site: string; demo: string }> = {
  erp: { site: "https://gestion-comercial.pages.dev", demo: "https://gestion-comercial.pages.dev/#demo" },
  arena: { site: "https://arena-connect.pages.dev", demo: "https://arena-connect.pages.dev/#en-vivo" },
};

const cart = [
  { name: "Yerba Canaria 500 g", qty: 2, total: "25.000" },
  { name: "Coca-Cola 2 L", qty: 3, total: "28.500" },
  { name: "Leche Ilolay 1 L", qty: 1, total: "7.800" },
];

const teams = {
  a: { name: "Bogado / Canese", sets: ["6", "4", "10"], winner: true },
  b: { name: "Aguirre / Romero", sets: ["4", "6", "8"], winner: false },
};
---

<section id="producto" class="mx-auto w-full max-w-6xl scroll-mt-20 px-5 pt-24 sm:px-8">
  <div class="reveal max-w-2xl">
    <p class="font-mono text-[12.5px] uppercase tracking-[.18em]" style="color: var(--accent)">_{dict.products.eyebrow}</p>
    <h2 class="font-display mt-3 text-[clamp(1.9rem,1rem+3.4vw,3rem)] font-bold leading-[1.05]">{dict.products.title}</h2>
    <p class="mt-4 text-[16.5px] leading-relaxed" style="color: var(--muted)">{dict.products.sub}</p>
  </div>

  <div class="mt-10 grid items-start gap-6 lg:grid-cols-2">
    {dict.products.items.map((p: ProductItem, i: number) => (
      <div class="reveal surface rounded-[28px] p-7 sm:p-8" style={`--d: ${i * 90}ms`}>
        <div class="flex items-center gap-2.5">
          <span
            class="rounded-full px-3 py-1 font-mono text-[11.5px] font-medium"
            style="background: var(--surface-2); color: var(--accent)"
          >{p.badge}</span>
          {p.chips.map((c) => (
            <span
              class="rounded-full px-3 py-1 font-mono text-[11.5px]"
              style="background: var(--surface-2); color: var(--muted)"
            >{c}</span>
          ))}
        </div>
        <h3 class="font-display mt-5 text-[24px] font-bold">{p.name}</h3>
        <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--muted)">{p.desc}</p>
        <ul class="mt-5 space-y-2.5 border-t pt-5" style="border-color: var(--line)">
          {p.bullets.map((b) => (
            <li class="flex items-start gap-2.5 text-[14.5px]" style="color: var(--muted)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true">
                <circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" />
              </svg>
              {b}
            </li>
          ))}
        </ul>

        {p.id === "erp" ? (
          <div class="mt-6 overflow-hidden rounded-2xl border" style="background:#101014; border-color: rgba(255,255,255,.1)" aria-hidden="true">
            <div class="flex items-center gap-3 border-b px-4 py-2.5" style="background:#16161b; border-color: rgba(255,255,255,.07)">
              <div class="flex gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full" style="background:#ff5f57"></span>
                <span class="h-2.5 w-2.5 rounded-full" style="background:#febc2e"></span>
                <span class="h-2.5 w-2.5 rounded-full" style="background:#28c840"></span>
              </div>
              <span class="text-[12.5px] font-medium" style="color:#98a2b3">{p.windowTitle}</span>
            </div>
            <ul class="space-y-2 p-4">
              {cart.map((item) => (
                <li class="flex items-center justify-between rounded-xl px-3.5 py-2.5" style="background:#16161b">
                  <span class="text-[13.5px] font-medium" style="color:#f5f5f7">{item.name}</span>
                  <span class="font-mono text-[12.5px]" style="color:#98a2b3">{item.qty} × ····· Gs. {item.total}</span>
                </li>
              ))}
            </ul>
            <div class="flex items-center justify-between border-t px-4 py-3" style="border-color: rgba(255,255,255,.07)">
              <span class="text-[12px] font-semibold uppercase tracking-widest" style="color:#71717a">{p.totalLabel}</span>
              <span class="font-display text-[20px] font-bold" style="color:#f5f5f7">Gs. 61.300</span>
            </div>
            <div class="px-4 pb-4">
              <div class="flex items-center justify-center rounded-xl py-2.5 text-[13px] font-bold" style="background: var(--accent); color:#fff">
                {p.payLabel} · Gs. 61.300
              </div>
            </div>
          </div>
        ) : (
          <div class="mt-6 overflow-hidden rounded-2xl border" style="background:#0a0e14; border-color: rgba(255,255,255,.1)" aria-hidden="true">
            <div class="flex items-center justify-between border-b px-4 py-2.5" style="background:#121822; border-color: rgba(255,255,255,.07)">
              <span class="text-[12.5px] font-medium" style="color:#8a94a6">{p.windowTitle}</span>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10.5px] font-bold uppercase tracking-widest text-white" style="background:#e85d4e; clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 0 100%)">
                <span class="h-1.5 w-1.5 rounded-full bg-white" style="animation: live-pulse 1.6s ease-in-out infinite"></span>
                {p.liveLabel}
              </span>
            </div>
            <div class="px-4 py-4" style="grid-template-columns: 1fr repeat(3, 2.6rem); display: grid; column-gap: 10px; align-items: center;">
              <span class="text-[13px] font-semibold uppercase tracking-wide" style="color:#38e1ff">{teams.a.name}</span>
              {teams.a.sets.map((s, k) => (
                <span class="text-center font-display text-[20px] font-bold" style={k === 2 ? "color:#f7c85f" : "color:#e6ebf2"}>{s}</span>
              ))}
              <span class="text-[13px] font-semibold uppercase tracking-wide" style="color:#8a94a6">{teams.b.name}</span>
              {teams.b.sets.map((s) => (
                <span class="text-center font-display text-[20px] font-bold" style="color:#8a94a6">{s}</span>
              ))}
            </div>
          </div>
        )}

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href={PRODUCT_URLS[p.id]?.site ?? "#"}
            target="_blank"
            rel="noopener"
            class="btn-accent cursor-pointer px-6 py-3 text-center text-[14.5px] font-semibold"
          >{p.cta}</a>
          <a
            href={PRODUCT_URLS[p.id]?.demo ?? "#"}
            target="_blank"
            rel="noopener"
            class="surface cursor-pointer rounded-full px-6 py-3 text-center text-[14.5px] font-semibold transition-transform hover:scale-[1.03] active:scale-[.97]"
          >{p.demo}</a>
        </div>
      </div>
    ))}
  </div>
</section>

<style is:global>
  @keyframes live-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
</style>
