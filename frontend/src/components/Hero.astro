---
import type { Dict } from "../i18n/es";

const { dict, lang } = Astro.props as { dict: Dict; lang: "es" | "en" };
const contactHref = `/${lang}/#contacto`;
const servicesHref = `/${lang}/#servicios`;
const stat = dict.hero.stats[0];
---

<section class="hero-full relative flex flex-col px-5 pt-12 sm:px-8">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="relative mx-auto flex w-full max-w-6xl flex-1 flex-col items-center justify-center pb-12 text-center">
    {dict.hero.badge && (
      <a
        href={servicesHref}
        class="enter surface inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-[13.5px] font-medium"
        style="color: var(--muted)"
      >
        <span class="inline-block h-2 w-2 rounded-full" style="background: var(--accent)" aria-hidden="true"></span>
        {dict.hero.badge}
      </a>
    )}
    <p class="enter font-mono text-[12px] uppercase tracking-[0.24em] text-balance" style="color: var(--muted); --d: 60ms">
      {dict.hero.eyebrow}
    </p>
    <h1 class="hero-title font-display mt-6 font-extrabold tracking-tight">
      <span class="enter block" style="--d: 160ms">{dict.hero.titleA}</span>
      <span class="enter block" style="color: var(--accent); --d: 280ms">{dict.hero.titleAccent}</span>
    </h1>
    <p class="enter mx-auto mt-7 max-w-2xl text-[17px] leading-relaxed" style="color: var(--muted); --d: 400ms">
      {dict.hero.sub}
    </p>
    <div class="enter mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--d: 500ms">
      <a
        href={contactHref}
        class="btn-accent cursor-pointer w-full px-7 py-3.5 text-[15.5px] font-semibold sm:w-auto"
      >{dict.hero.primary}</a>
      <a
        href={servicesHref}
        class="surface cursor-pointer w-full rounded-full px-7 py-3.5 text-[15.5px] font-semibold transition-transform hover:scale-[1.03] active:scale-[.97] sm:w-auto"
      >{dict.hero.secondary}</a>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-6xl">
    <div
      class="enter flex flex-col items-center gap-4 border-t py-6 sm:grid sm:grid-cols-3 sm:items-center"
      style="border-color: var(--line); --d: 620ms"
    >
      <p class="order-2 font-mono text-[12.5px] sm:order-1 sm:justify-self-start" style="color: var(--muted)">
        <span class="font-display text-[15px] font-bold" style="color: var(--text)" data-countup={stat.value}>{stat.value}</span>
        {" "}{stat.label}
      </p>
      <div class="order-1 flex flex-col items-center gap-3 sm:order-2" aria-hidden="true">
        <span class="scroll-cue"></span>
        <span class="font-mono text-[11.5px] uppercase tracking-[0.2em]" style="color: var(--muted)">
          {dict.hero.scroll}
        </span>
      </div>
      <p class="order-3 text-center font-mono text-[12.5px] sm:justify-self-end sm:text-right" style="color: var(--muted)">
        {dict.hero.note}
      </p>
    </div>

    <div class="enter mt-1 pb-10" style="--d: 720ms" aria-label={dict.hero.techLabel}>
      <p class="text-center font-mono text-[12px] uppercase tracking-[0.18em]" style="color: var(--muted)">{dict.hero.techLabel}</p>
      <div class="relative mt-4" style="mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent)">
        <div class="marquee-track flex w-max gap-3 pr-3">
          {[...dict.logos, ...dict.logos].map((t) => (
            <span class="surface whitespace-nowrap rounded-full px-5 py-2 font-mono text-[13px]" style="color: var(--muted)" aria-hidden="true">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
