---
import type { Dict } from "../i18n/es";

const { dict } = Astro.props as { dict: Dict };

function spanClass(span: string) {
  if (span === "large") return "sm:col-span-4";
  if (span === "medium") return "sm:col-span-2";
  return "sm:col-span-2";
}

// Iconos de trazo (24px, stroke 1.6) — monocromos, heredan el color del tile.
function iconPaths(name: string) {
  switch (name) {
    case "web": // monitor con brackets de código
      return '<rect x="3" y="4.5" width="18" height="13" rx="2.5"/><path d="m9.5 9-2.2 2.5L9.5 14"/><path d="m14.5 9 2.2 2.5-2.2 2.5"/><path d="M9 21h6"/>';
    case "mobile": // smartphone
      return '<rect x="7" y="3" width="10" height="18" rx="2.5"/><path d="M11 17.5h2"/>';
    case "backend": // servidores apilados
      return '<rect x="4" y="4" width="16" height="7" rx="2"/><rect x="4" y="13" width="16" height="7" rx="2"/><circle cx="8" cy="7.5" r="1"/><circle cx="8" cy="16.5" r="1"/>';
    case "design": // lápiz
      return '<path d="m14.5 5.5 4 4L8 20l-4.5.5L4 16Z"/><path d="m12.5 7.5 4 4"/>';
    case "care": // salvavidas
      return '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4"/><path d="m5.9 5.9 3.5 3.5M18.1 5.9l-3.5 3.5M18.1 18.1l-3.5-3.5M5.9 18.1l3.5-3.5"/>';
    default:
      return "";
  }
}
---

<section id="servicios" class="mx-auto w-full max-w-6xl scroll-mt-20 px-5 pt-24 sm:px-8">
  <div class="reveal max-w-2xl">
    <p class="font-mono text-[12.5px] uppercase tracking-[0.18em]" style="color: var(--accent)">_{dict.services.eyebrow}</p>
    <h2 class="font-display mt-3 text-[clamp(1.9rem,1rem+3.4vw,3rem)] font-bold leading-[1.05]">{dict.services.title}</h2>
    <p class="mt-4 text-[16.5px] leading-relaxed" style="color: var(--muted)">{dict.services.sub}</p>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-6">
    {dict.services.items.map((s, i) => (
      <article
        class={`reveal surface bento-card cursor-pointer rounded-[28px] p-6 sm:p-7 ${spanClass(s.span)}`}
        style={`--d: ${i * 70}ms`}
      >
        <div class="flex items-center justify-between gap-3">
          <span
            class="icon-tile inline-flex h-11 w-11 items-center justify-center rounded-xl transition-colors"
            style="background: var(--surface-2); border: 1px solid var(--line); color: var(--accent)"
            aria-hidden="true"
          >
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={iconPaths(s.icon)} />
            </svg>
          </span>
          <span
            class="inline-block rounded-full px-3 py-1 font-mono text-[12px] font-medium"
            style="background: var(--surface-2); color: var(--accent)"
          >{s.tag}</span>
        </div>
        <h3 class="font-display mt-5 text-[20px] font-bold">{s.title}</h3>
        <p class="mt-2 text-[14.5px] leading-relaxed" style="color: var(--muted)">{s.desc}</p>
      </article>
    ))}
  </div>
</section>

<style is:global>
  .bento-card:hover .icon-tile {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }
</style>
