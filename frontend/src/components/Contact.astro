---
import ContactForm from "./react/ContactForm";
import type { Dict } from "../i18n/es";

const { dict } = Astro.props as { dict: Dict };
// NOTA: secciones Casos/Testimonios ocultas por decisión del cliente (paso 3).
// Los textos siguen en el diccionario i18n para reactivarlas cuando haya contenido real.
---

<section id="contacto" class="mx-auto w-full max-w-6xl scroll-mt-20 px-5 py-24 sm:px-8">
  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
    <div class="reveal">
      <p class="font-mono text-[12.5px] uppercase tracking-[0.18em]" style="color: var(--accent)">_{dict.contact.eyebrow}</p>
      <h2 class="font-display mt-3 text-[clamp(1.9rem,1rem+3.6vw,3.1rem)] font-bold leading-[1.04]">{dict.contact.title}</h2>
      <p class="mt-4 max-w-md text-[16px] leading-relaxed" style="color: var(--muted)">{dict.contact.sub}</p>
      <a
        href={`mailto:${dict.contact.email}`}
        class="surface cursor-pointer mt-6 inline-flex items-center gap-3 rounded-full py-2 pl-2 pr-6 transition-transform hover:scale-[1.02]"
      >
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-full text-white" style="background: var(--accent)" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
        </span>
        <span class="font-mono text-[14.5px] font-medium">{dict.contact.email}</span>
      </a>
    </div>
    <div class="reveal" style="--d: 120ms">
      <ContactForm client:load labels={dict.contact.form} />
    </div>
  </div>
</section>
