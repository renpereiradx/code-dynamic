---
import ContactForm from "./react/ContactForm";
import type { Dict } from "../i18n/es";

const { dict } = Astro.props as { dict: Dict };
---

<section id="casos" class="mx-auto w-full max-w-6xl scroll-mt-20 px-5 pt-24 sm:px-8">
  <div class="reveal max-w-2xl">
    <p class="font-mono text-[12.5px] uppercase tracking-[0.18em]" style="color: var(--accent)">_{dict.work.eyebrow}</p>
    <h2 class="font-display mt-3 text-[clamp(1.9rem,1rem+3.4vw,3rem)] font-bold leading-[1.05]">{dict.work.title}</h2>
    <p class="mt-3 font-mono text-[12.5px]" style="color: var(--muted)">{dict.work.note}</p>
  </div>
  <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
    {dict.work.items.map((c, i) => (
      <article class="reveal surface bento-card rounded-3xl p-6 sm:p-7" style={`--d: ${i * 80}ms`}>
        <span class="inline-block rounded-full px-3 py-1 font-mono text-[12px]" style="background: var(--surface-2); color: var(--accent)">{c.tag}</span>
        <h3 class="font-display mt-4 text-[19px] font-bold">{c.title}</h3>
        <p class="mt-2 text-[14.5px] leading-relaxed" style="color: var(--muted)">{c.desc}</p>
      </article>
    ))}
  </div>
</section>

<section class="mx-auto w-full max-w-6xl px-5 pt-20 sm:px-8" aria-label={dict.quotes.eyebrow}>
  <div class="reveal max-w-2xl">
    <p class="font-mono text-[12.5px] uppercase tracking-[0.18em]" style="color: var(--accent)">_{dict.quotes.eyebrow}</p>
    <h2 class="font-display mt-3 text-[clamp(1.6rem,0.9rem+2.8vw,2.4rem)] font-bold">{dict.quotes.title}</h2>
    <p class="mt-3 font-mono text-[12.5px]" style="color: var(--muted)">{dict.quotes.note}</p>
  </div>
  <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
    {dict.quotes.items.map((q, i) => (
      <figure class="reveal surface rounded-3xl p-6 sm:p-8" style={`--d: ${i * 90}ms`}>
        <blockquote class="font-display text-[19px] font-medium leading-snug">“{q.quote}”</blockquote>
        <figcaption class="mt-4 text-[14px]" style="color: var(--muted)">— {q.author}</figcaption>
      </figure>
    ))}
  </div>
</section>

<section id="contacto" class="mx-auto w-full max-w-6xl scroll-mt-20 px-5 py-24 sm:px-8">
  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
    <div class="reveal">
      <p class="font-mono text-[12.5px] uppercase tracking-[0.18em]" style="color: var(--accent)">_{dict.contact.eyebrow}</p>
      <h2 class="font-display mt-3 text-[clamp(1.9rem,1rem+3.6vw,3.1rem)] font-bold leading-[1.04]">{dict.contact.title}</h2>
      <p class="mt-4 max-w-md text-[16px] leading-relaxed" style="color: var(--muted)">{dict.contact.sub}</p>
      <a
        href={`mailto:${dict.contact.email}`}
        class="surface cursor-pointer mt-6 inline-flex items-center gap-3 rounded-full py-2 pl-2 pr-6 transition-transform hover:scale-[1.02]"
      >
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-full text-white" style="background: var(--accent)" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
        </span>
        <span class="font-mono text-[14.5px] font-medium">{dict.contact.email}</span>
      </a>
    </div>
    <div class="reveal" style="--d: 120ms">
      <ContactForm client:load labels={dict.contact.form} />
    </div>
  </div>
</section>
