---
import "../styles/global.css";
import ThemeToggle from "../components/react/ThemeToggle";
import type { Dict } from "../i18n/es";

interface Props {
  lang: "es" | "en";
  title: string;
  description: string;
  dict: Dict;
}

const { lang, title, description, dict } = Astro.props;
const otherLang = lang === "es" ? "en" : "es";
const base = import.meta.env.BASE_URL ?? "/";
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0B" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem("cd-theme");
        const theme =
          saved === "light" || saved === "dark"
            ? saved
            : window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
  </head>
  <body>
    <div
      class="scroll-progress fixed inset-x-0 top-0 z-[60] h-[2px]"
      style="background: var(--accent)"
      aria-hidden="true"
    ></div>

    <header class="glass-nav sticky top-0 z-50">
      <nav
        class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-5 sm:px-8"
        aria-label={lang === "es" ? "Navegación principal" : "Main navigation"}
      >
        <a href={`/${lang}/`} class="flex items-center gap-2.5" aria-label="Code Dynamic — home">
          <img src={`${base}favicon.svg`} alt="" width="30" height="30" class="rounded-lg" />
          <span class="font-display text-[17px] font-bold tracking-tight">Code&nbsp;Dynamic</span>
        </a>

        <div class="hidden items-center gap-7 text-[14.5px] md:flex" style="color: var(--muted)">
          <a class="transition-colors hover:text-[var(--text)]" href={`/${lang}/#servicios`}>{dict.nav.services}</a>
          <a class="transition-colors hover:text-[var(--text)]" href={`/${lang}/#proceso`}>{dict.nav.process}</a>
          <a class="transition-colors hover:text-[var(--text)]" href={`/${lang}/#stack`}>{dict.nav.stack}</a>
        </div>

        <div class="flex items-center gap-2.5">
          <div
            class="hidden items-center rounded-full border p-1 text-[13px] font-semibold sm:flex"
            style="border-color: var(--line)"
            role="group"
            aria-label="Idioma / Language"
          >
            <a
              href="/es/"
              aria-current={lang === "es" ? "page" : undefined}
              class="rounded-full px-3 py-1"
              style={lang === "es" ? "background: var(--surface-2); color: var(--text)" : "color: var(--muted)"}
            >ES</a>
            <a
              href="/en/"
              aria-current={lang === "en" ? "page" : undefined}
              class="rounded-full px-3 py-1"
              style={lang === "en" ? "background: var(--surface-2); color: var(--text)" : "color: var(--muted)"}
            >EN</a>
          </div>
          <a
            href={`/${otherLang}/`}
            class="rounded-full border px-3 py-1.5 text-[13px] font-semibold sm:hidden"
            style="border-color: var(--line); color: var(--muted)"
          >{otherLang.toUpperCase()}</a>
          <ThemeToggle client:load />
          <a
            href={`/${lang}/#contacto`}
            class="cursor-pointer hidden rounded-full px-5 py-2.5 text-[14px] font-semibold text-white transition-transform hover:scale-[1.03] active:scale-[.97] sm:inline-block"
            style="background: var(--accent)"
          >{dict.nav.cta}</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t" style="border-color: var(--line)">
      <div class="mx-auto grid w-full max-w-6xl gap-10 px-5 py-14 sm:px-8 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <div class="flex items-center gap-2.5">
            <img src={`${base}favicon.svg`} alt="" width="26" height="26" class="rounded-lg" />
            <span class="font-display text-[16px] font-bold">Code&nbsp;Dynamic</span>
          </div>
          <p class="mt-4 max-w-xs text-[14.5px] leading-relaxed" style="color: var(--muted)">
            {dict.footer.tagline}
          </p>
        </div>
        <nav aria-label={dict.footer.sections}>
          <p class="text-[13px] font-semibold uppercase tracking-widest" style="color: var(--muted)">{dict.footer.sections}</p>
          <ul class="mt-4 space-y-2.5 text-[14.5px]">
            <li><a class="hover:underline" href={`/${lang}/#servicios`}>{dict.nav.services}</a></li>
            <li><a class="hover:underline" href={`/${lang}/#proceso`}>{dict.nav.process}</a></li>
            <li><a class="hover:underline" href={`/${lang}/#stack`}>{dict.nav.stack}</a></li>
            <li><a class="hover:underline" href={`/${lang}/#contacto`}>{dict.nav.contact}</a></li>
          </ul>
        </nav>
        <div>
          <p class="text-[13px] font-semibold uppercase tracking-widest" style="color: var(--muted)">{dict.footer.contactTitle}</p>
          <ul class="mt-4 space-y-2.5 text-[14.5px]">
            <li><a class="hover:underline" href={`mailto:${dict.contact.email}`}>{dict.contact.email}</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t" style="border-color: var(--line)">
        <div
          class="mx-auto flex w-full max-w-6xl flex-col gap-1 px-5 py-5 text-[13px] sm:flex-row sm:items-center sm:justify-between sm:px-8"
          style="color: var(--muted)"
        >
          <span>{dict.footer.rights}</span>
          <span class="font-mono text-[12px]">{dict.footer.demo}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Reveal on scroll — una vez por elemento, respeta prefers-reduced-motion por CSS.
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
